{
	"extends": "../../../sdk/packages/tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ESNext",
		"paths": {
			"@sctg/cline-agents": ["../../../sdk/packages/agents/src/index.ts"],
			"@sctg/cline-agents/*": [
				"../../../sdk/packages/agents/src/*",
				"../../../sdk/packages/agents/src/*/index.ts"
			],
			"@sctg/cline-core": ["../../../sdk/packages/core/src/index.ts"],
			"@sctg/cline-core/hub/daemon-entry": [
				"../../../sdk/packages/core/src/hub/daemon/entry.ts"
			],
			"@sctg/cline-core/*": [
				"../../../sdk/packages/core/src/*",
				"../../../sdk/packages/core/src/*/index.ts"
			],
			"@sctg/cline-llms": ["../../../sdk/packages/llms/src/index.ts"],
			"@sctg/cline-shared": ["../../../sdk/packages/shared/src/index.ts"],
			"@sctg/cline-shared/storage": [
				"../../../sdk/packages/shared/src/storage/index.ts"
			],
			"@sctg/cline-shared/db": ["../../../sdk/packages/shared/src/db/index.ts"],
			"@sctg/cline-shared/*": [
				"../../../sdk/packages/shared/src/*",
				"../../../sdk/packages/shared/src/*/index.ts"
			]
		}
	},
	"include": ["sidecar/**/*.ts"]
}
