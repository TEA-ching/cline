{
  "name": "@sctg/cline-chatbot",
  "version": "4.0.0-beta.20260805064650",
  "description": "Reusable KeypoolLive chatbot React component (<Chatbot />) built on @sctg/cline-agents, @sctg/cline-llms and @sctg/cline-shared",
  "type": "module",
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./vite-plugin": {
      "types": "./dist-lib/vite-plugin.d.ts",
      "import": "./dist-lib/vite-plugin.js"
    },
    "./style.css": "./dist-lib/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@heroui/react": "3.1.0",
    "@heroui/styles": "3.1.0",
    "@jitl/quickjs-singlefile-browser-release-asyncify": "^0.32.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@tailwindcss/vite": "^4.3.0",
    "dompurify": "^3.4.11",
    "embed-eslint": "^3.1.0",
    "embed-typescript": "^3.1.0",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "markdown-docx": "^1.6.0",
    "marked": "^18.0.5",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.15.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "pyodide": "^314.0.0",
    "quickjs-emscripten": "^0.32.0",
    "shiki": "^4.2.0",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.0",
    "use-sync-external-store": "^1.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sctg/cline-agents": "workspace:*",
    "@sctg/cline-llms": "workspace:*",
    "@sctg/cline-shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "terser": "^5.48.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TEA-ching/cline"
  }
}
